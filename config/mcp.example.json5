// Merge vào ~/.openclaw/openclaw.json → mcp.servers
// Đừng commit token / oauth.json. Dùng ${ENV}.
// Mặc định TẮT. Chưa enabled + chưa login = không gọi mcp_drive.
// Không thêm Apify / X để lấy giá shop.
//
// Bật: chủ login Drive (Cursor Settings và/hoặc openclaw mcp login gdrive)
// rồi enabled: true. openclaw mcp doctor --probe.
// Chưa chắc server: để enabled false, xin file tay.

{
  mcp: {
    servers: {
      gdrive: {
        enabled: false,
        command: "npx",
        args: ["-y", "@modelcontextprotocol/server-gdrive"],
        env: {
          GDRIVE_OAUTH_PATH: "${GDRIVE_OAUTH_PATH}",
        },
        toolFilter: {
          include: ["search*", "read*", "list*", "get*"],
        },
      },
    },
  },
}
