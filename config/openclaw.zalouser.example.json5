// Merge vào ~/.openclaw/openclaw.json trên máy Gateway.
// Đừng commit file thật, cookie, QR.
// CSKH: dmPolicy PHẢI là open — khách lạ vào được.
// Tom cá nhân hay để pairing; đừng copy pairing sang shop.
//
// Tên: Nami (IDENTITY.md). OpenClaw suy mentionPatterns từ identity.name
// → nhóm: "Nami" / "Nami ơi" / @Nami là gọi mình. Inbox 1-1 luôn vào.
// Đổi tên thì đổi IDENTITY + identity.name dưới đây cho khớp.
// Model agent nên có vision — khách CSKH hay gửi ảnh.
// workspace: dùng đường dẫn tuyệt đối tới thư mục repo shop (không để "." nếu
// Gateway chạy từ thư mục khác).

{
  channels: {
    zalouser: {
      enabled: true,
      dmPolicy: "open",
      groupPolicy: "allowlist",
      groups: {
        // "*" chỉ đặt mặc định cho mention gating, KHÔNG mở nhóm nào cả.
        "*": { enabled: true, requireMention: true },
        // Khoá phải là ID nhóm, không phải tên. Tên chỉ khớp khi bật
        // dangerouslyAllowNameMatching — đừng bật.
        // "1234567890": { enabled: true, requireMention: true },
      },
      // CẨN THẬN: groupAllowFrom trống = MỌI người trong nhóm đã cho phép đều
      // gọi được bot. Nó KHÔNG tự lấy allowFrom. Với CSKH thường là đúng ý
      // (ai trong nhóm cũng hỏi được), nhưng phải biết mình đang chọn cái đó.
      // groupAllowFrom: ["<id-nguoi-duoc-goi>"],
    },
  },
  agents: {
    defaults: {
      workspace: ".", // trỏ vào thư mục repo/workspace của shop
      identity: {
        name: "Nami",
      },
    },
    // Có biệt hiệu thì bỏ comment, giữ "nami" trong list:
    // entries: {
    //   main: {
    //     identity: { name: "Nami" },
    //     groupChat: {
    //       mentionPatterns: ["nami", "nami\\s*ơi", "nami\\s*oi", "shop\\s*ơi"],
    //     },
    //   },
    // },
  },
  // MCP: merge config/mcp.example.json5. Mặc định không bật Drive.
  // mcp: { servers: { gdrive: { enabled: false } } },
}
